// nf-core subworkflows test variant_calling_mpileup
nextflow_workflow {

    name "Test Subworkflow VARIANTS_QUANTIFICATION"
    script "../main.nf"
    workflow "VARIANTS_QUANTIFICATION"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "subworkflows/variant_calling_mpileup"
    tag "samtools"
    tag "samtools/mpileup"
    tag "mpileup/nucl/freq"
    tag "abotyper"

    test("abotyper - variant calling from bam to frequency stats") {

        when {
            workflow {
                """
                // ch_bam: BAM files with exon metadata (using sarscov2 test BAM as placeholder)
                input[0] = Channel.of(
                    [
                        [ id:'test_sample', single_end:true, exon:'exon6', ref_id:'A1_01_01_1_reference_Exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                    ]
                )

                // ch_bai: BAM index files with matching metadata
                input[1] = Channel.of(
                    [
                        [ id:'test_sample', single_end:true, exon:'exon6', ref_id:'A1_01_01_1_reference_Exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                    ]
                )

                // ch_fasta: FASTA reference files with exon metadata (using abotyper references)
                input[2] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta', checkIfExists: true)
                    ]
                )

                // ch_fai: FASTA index files with matching metadata
                input[3] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta.fai', checkIfExists: true)
                    ]
                )

                // ch_bed: BED interval files with exon metadata (using sarscov2 test bed as placeholder)
                input[4] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6.fasta', exon:'exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.metrics.size() >= 1 },
                { assert workflow.out.versions.size() > 0 },
                { assert workflow.trace.succeeded().size() >= 2 }, // SAMTOOLS_MPILEUP + MPILEUP_NUCL_FREQ
                { assert snapshot(
                    workflow.out.versions,
                    workflow.trace.succeeded().size()
                ).match() }
            )
        }
    }

    test("abotyper - variant calling - single sample") {

        when {
            workflow {
                """
                // Test with single sample
                input[0] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', single_end:true, exon:'exon6', ref_id:'A1_01_01_1_reference_Exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                    ]
                )

                input[1] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', single_end:true, exon:'exon6', ref_id:'A1_01_01_1_reference_Exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                    ]
                )

                input[2] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta', checkIfExists: true)
                    ]
                )

                input[3] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta.fai', checkIfExists: true)
                    ]
                )

                input[4] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6.fasta', exon:'exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.metrics.size() >= 1 },
                { assert workflow.out.versions.size() > 0 },
                { assert workflow.trace.succeeded().size() >= 1 },
                { assert snapshot(
                    workflow.out.versions,
                    workflow.trace.succeeded().size()
                ).match() }
            )
        }
    }

    test("abotyper - variant calling - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id:'test_sample', single_end:true, exon:'exon6', ref_id:'A1_01_01_1_reference_Exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam', checkIfExists: true)
                    ]
                )

                input[1] = Channel.of(
                    [
                        [ id:'test_sample', single_end:true, exon:'exon6', ref_id:'A1_01_01_1_reference_Exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/illumina/bam/test.paired_end.sorted.bam.bai', checkIfExists: true)
                    ]
                )

                input[2] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta', checkIfExists: true)
                    ]
                )

                input[3] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta.fai', checkIfExists: true)
                    ]
                )

                input[4] = Channel.of(
                    [
                        [ id:'A1_01_01_1_reference_Exon6.fasta', exon:'exon6' ],
                        file(params.modules_testdata_base_path + 'genomics/sarscov2/genome/bed/test.bed', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() },
                { assert workflow.trace.succeeded().size() >= 1 }
            )
        }
    }
}
