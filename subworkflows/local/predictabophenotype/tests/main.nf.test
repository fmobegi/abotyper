nextflow_workflow {

    name "Test Subworkflow PREDICTABOPHENOTYPE"
    script "../main.nf"
    workflow "PREDICTABOPHENOTYPE"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "predictabophenotype"
    tag "abotyper"

    test("abotyper - predict ABO phenotypes from variants and coverage") {

        when {
            workflow {
                """
                // Input channel 1: Variant frequency data with exon metadata
                input[0] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/ABO_AA_barcode01.AlignmentStatistics.tsv', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon7' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon7/ABO_AA_barcode01.AlignmentStatistics.tsv', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AB_barcode02', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/exon6/ABO_AB_barcode02.AlignmentStatistics.tsv', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AB_barcode02', exon:'exon7' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/exon7/ABO_AB_barcode02.AlignmentStatistics.tsv', checkIfExists: true)
                    ]
                )

                // Input channel 2: BAM coverage data with exon metadata (using proper coverage files)
                input[1] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/alignment/ABO_AA_barcode01.coverage.txt', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon7' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon7/alignment/ABO_AA_barcode01.coverage.txt', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AB_barcode02', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/exon6/alignment/ABO_AB_barcode02.coverage.txt', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AB_barcode02', exon:'exon7' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/exon7/alignment/ABO_AB_barcode02.coverage.txt', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.versions.size() > 0 },
                { assert workflow.trace.succeeded().size() >= 2 }, // GETABOSNPS + ABOSNPS2PHENO
                { assert snapshot(
                    workflow.out.versions,
                    workflow.trace.succeeded().size()
                ).match() }
            )
        }
    }

    test("abotyper - predict ABO phenotypes - single sample") {

        when {
            workflow {
                """
                // Test with just one sample to verify basic functionality
                input[0] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/ABO_AA_barcode01.AlignmentStatistics.tsv', checkIfExists: true)
                    ]
                )

                input[1] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/alignment/ABO_AA_barcode01.coverage.txt', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert workflow.out.versions.size() > 0 },
                { assert workflow.trace.succeeded().size() >= 1 },
                { assert snapshot(
                    workflow.out.versions,
                    workflow.trace.succeeded().size()
                ).match() }
            )
        }
    }

    test("abotyper - predict ABO phenotypes - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/ABO_AA_barcode01.AlignmentStatistics.tsv', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AB_barcode02', exon:'exon7' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/exon7/ABO_AB_barcode02.AlignmentStatistics.tsv', checkIfExists: true)
                    ]
                )

                input[1] = Channel.of(
                    [
                        [ id:'ABO_AA_barcode01', exon:'exon6' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AA_barcode01/exon6/alignment/ABO_AA_barcode01.coverage.txt', checkIfExists: true)
                    ],
                    [
                        [ id:'ABO_AB_barcode02', exon:'exon7' ],
                        file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing/ABO_AB_barcode02/exon7/alignment/ABO_AB_barcode02.coverage.txt', checkIfExists: true)
                    ]
                )
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                { assert snapshot(workflow.out).match() },
                { assert workflow.trace.succeeded().size() >= 1 }
            )
        }
    }
}