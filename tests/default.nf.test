nextflow_pipeline {

    name "Test pipeline"
    script "../main.nf"
    tag "pipeline"

    
    // Test configuration
    test ("-profile test") {
        nextflow_pipeline {
            name "Test pipeline"
            script "../main.nf"
            tag "pipeline"

            test("-profile test") {
                when {
                    params {
                        outdir = "$outputDir"
                    }
                }

                then {
                    // Core file structure validation - exclude time-stamped and volatile files
                    def stable_name = getAllFilesFromDir(params.outdir, relative: true, includeDir: true, 
                        ignore: [
                            'pipeline_info/execution_*.{html,txt}',
                            'pipeline_info/execution_timeline_*.html',
                            'pipeline_info/pipeline_dag_*.html', 
                            'pipeline_info/params_*.json',
                            'qc-reports/multiqc/*_multiqc_report_data/**',
                            'qc-reports/multiqc/*_multiqc_report_plots/**',
                            'qc-reports/fastqc/*.{html,zip}'  // FastQC files normally skipped
                        ])
                    
                    // Stable content files
                    def stable_path = getAllFilesFromDir(params.outdir, ignoreFile: 'tests/.nftignore')
                    
                    // ABO-specific critical outputs
                    def abo_phenotype_files = getAllFilesFromDir(params.outdir, include: ['per_sample_processing/**/exon*/*.ABOPhenotype.txt'])
                    def alignment_stats_files = getAllFilesFromDir(params.outdir, include: ['per_sample_processing/**/exon*/*.AlignmentStatistics.tsv'])
                    def polymorphism_files = getAllFilesFromDir(params.outdir, include: ['per_sample_processing/**/exon*/ABOReadPolymorphisms.txt'])
                    
                    // Alignment outputs
                    def bam_files = getAllFilesFromDir(params.outdir, include: ['per_sample_processing/**/exon*/alignment/*.bam'])
                    def coverage_files = getAllFilesFromDir(params.outdir, include: ['per_sample_processing/**/exon*/alignment/*.coverage.txt'])
                    def flagstat_files = getAllFilesFromDir(params.outdir, include: ['per_sample_processing/**/exon*/alignment/*.flagstat'])
                    
                    // Summary outputs
                    def final_results = [
                        path(params.outdir + '/ABO_result.txt'),
                        path(params.outdir + '/ABO_result.xlsx'), 
                        path(params.outdir + '/final_export.csv')
                    ]
                    
                    // Quality control (excluding volatile FastQC files)
                    def multiqc_report = path(params.outdir).list().find { 
                        it.isDirectory() && it.name == 'qc-reports' 
                    }?.list()?.find { 
                        it.isDirectory() && it.name == 'multiqc' 
                    }?.list()?.find { 
                        it.name.endsWith('_multiqc_report.html') 
                    }

                    assertAll(
                        { assert workflow.success },
                        
                        // Validate workflow execution and structure
                        { assert snapshot(
                            workflow.trace.succeeded().size(),
                            removeNextflowVersion("$outputDir/pipeline_info/nf_core_abotyper_software_mqc_versions.yml"),
                            stable_name
                        ).match("workflow_structure") },
                        
                        // Validate ABO phenotype results (critical for blood typing)
                        { assert snapshot(
                            abo_phenotype_files.collect { file -> 
                                def sampleName = file.getParent().getParent().getName()
                                def exon = file.getParent().getName()
                                [sampleName, exon, path(file.toString()).readLines().findAll { !it.startsWith('#') && it.trim() }]
                            }.sort { it[0] + it[1] }  // Sort by sample then exon
                        ).match("abo_phenotypes") },
                        
                        // Validate alignment statistics
                        { assert snapshot(
                            alignment_stats_files.collect { file -> 
                                def sampleName = file.getParent().getParent().getName()
                                def exon = file.getParent().getName()
                                [sampleName, exon, path(file.toString()).csv(sep:"\t").columnNames]
                            }.sort { it[0] + it[1] }
                        ).match("alignment_statistics") },
                        
                        // Validate polymorphism detection
                        { assert snapshot(
                            polymorphism_files.collect { file ->
                                def sampleName = file.getParent().getParent().getName() 
                                def exon = file.getParent().getName()
                                [sampleName, exon, path(file.toString()).readLines().size()]
                            }.sort { it[0] + it[1] }
                        ).match("polymorphism_counts") },
                        
                        // Validate alignment outputs
                        { assert snapshot(
                            bam_files.collect { file -> 
                                [file.getName(), bam(file.toString()).getStatistics()]
                            }.sort { it[0] },
                            coverage_files.collect { file ->
                                [file.getName(), path(file.toString()).readLines().size()]
                            }.sort { it[0] }
                        ).match("alignment_outputs") },
                        
                        // Validate expected sample count and exon coverage
                        { assert abo_phenotype_files.size() == 20 }, // 10 samples × 2 exons
                        { assert bam_files.size() == 20 }, // 10 samples × 2 exons
                        
                        // Validate final summary outputs exist
                        { assert final_results.every { it.exists() } },
                        { assert multiqc_report != null },
                        
                        // Validate final export structure
                        { assert path(params.outdir + '/final_export.csv').csv().columnNames.containsAll(['sample', 'phenotype']) }
                    )
                }
            }
        }
    }
}

