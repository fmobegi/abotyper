nextflow_process {

    name "Test Process MPILEUP_NUCL_FREQ"
    script "../main.nf"
    process "MPILEUP_NUCL_FREQ"

    tag "mpileup_nucl_freq"
    tag "abotyper"
    tag "abo_blood_typing"
    tag "nucleotide_frequency"

    test("Should process ABO exon6 pileup data correctly") {

        when {
            process {
                """
                input[0] = [
                    [ id:'NGSPOS_barcode01', exon:'exon6' ], // ABO-specific sample naming
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_exon6_ref' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Detailed content validation for snapshots
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).text,
                    path(process.out.txt.get(0)).text,
                    path(process.out.versions.get(0)).text
                ).match("exon6_outputs") },
                // File structure validation
                { assert process.out.tsv.size() == 1 },
                { assert process.out.tsv.get(0).get(0).id == 'NGSPOS_barcode01' },
                { assert path(process.out.tsv.get(0).get(1)).name == 'NGSPOS_barcode01.AlignmentStatistics.tsv' },
                { assert path(process.out.txt.get(0)).name == 'ABOReadPolymorphisms.txt' },
                // Content checksums for deterministic validation
                { assert path(process.out.tsv.get(0).get(1)).md5 == snapshot().match("tsv_checksum") },
                { assert path(process.out.txt.get(0)).md5 == snapshot().match("txt_checksum") }
            )
        }
    }

    test("Should process ABO exon7 pileup data correctly") {

        when {
            process {
                """
                input[0] = [
                    [ id:'NGSNEG_barcode12', exon:'exon7' ], // Different barcode for exon7
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_exon7_ref' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Content validation with snapshots
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).text,
                    path(process.out.txt.get(0)).text
                ).match("exon7_content") },
                { assert process.out.tsv.get(0).get(0).exon == 'exon7' },
                { assert path(process.out.tsv.get(0).get(1)).name == 'NGSNEG_barcode12.AlignmentStatistics.tsv' },
                { assert path(process.out.txt.get(0)).exists() },
                { assert path(process.out.txt.get(0)).text.length() > 0 }, // Should contain polymorphism data
                // Checksum validation for reproducibility
                { assert path(process.out.tsv.get(0).get(1)).md5 == snapshot().match("exon7_tsv_md5") }
            )
        }
    }

    test("Should handle different ABO sample naming patterns") {

        when {
            process {
                """
                input[0] = [
                    [ id:'IMM-45-44874_barcode25', sample_type:'control' ], // Complex naming pattern
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_ref' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.tsv.get(0).get(0).id == 'IMM-45-44874_barcode25' },
                { assert path(process.out.tsv.get(0).get(1)).name.startsWith('IMM-45-44874_barcode25') },
                { assert path(process.out.tsv.get(0).get(1)).name.endsWith('.AlignmentStatistics.tsv') },
                // Snapshot file content for complex naming patterns
                { assert snapshot(
                    process.out.tsv.get(0).get(0), // metadata
                    path(process.out.tsv.get(0).get(1)).text.readLines()[0..2] // first 3 lines for header check
                ).match("complex_naming_pattern") }
            )
        }
    }

    test("Should validate ABO-specific output content structure") {

        when {
            process {
                """
                input[0] = [
                    [ id:'INGSPOS_barcode01', blood_group:'unknown' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_ref' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Snapshot TSV structure and content for ABO analysis
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).text,
                    path(process.out.txt.get(0)).text,
                    path(process.out.versions.get(0)).text
                ).match("abo_content_structure") },
                // Validate TSV structure for ABO analysis
                {
                    def tsvContent = path(process.out.tsv.get(0).get(1)).text
                    assert tsvContent.contains("Position") || tsvContent.contains("Nucleotide") || tsvContent.contains("Frequency")
                },
                // Validate ABOReadPolymorphisms.txt for ABO-specific SNVs
                {
                    def polyContent = path(process.out.txt.get(0)).text
                    assert polyContent.length() > 0 // Should contain polymorphism data
                },
                // Ensure versions capture all required tools for ABO pipeline
                {
                    def versionsContent = path(process.out.versions.get(0)).text
                    assert versionsContent.contains("python:")
                    assert versionsContent.contains("gzip:")
                    assert versionsContent.contains("re:")
                },
                // Content checksums for deterministic validation
                { assert path(process.out.tsv.get(0).get(1)).md5 == snapshot().match("abo_tsv_checksum") },
                { assert path(process.out.txt.get(0)).md5 == snapshot().match("abo_txt_checksum") }
            )
        }
    }

    test("Should handle edge case with minimal pileup data") {

        when {
            process {
                """
                input[0] = [
                    [ id:'BTGSPOS_barcode19', coverage:'low' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_ref' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.tsv.size() == 1 },
                { assert process.out.txt.size() == 1 },
                { assert process.out.versions.size() == 1 },
                // Even with low coverage, files should be created
                { assert path(process.out.tsv.get(0).get(1)).exists() },
                { assert path(process.out.txt.get(0)).exists() },
                // Snapshot content even for edge cases
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).readLines().size(), // line count
                    path(process.out.txt.get(0)).readLines().size(), // line count
                    process.out.tsv.get(0).get(0) // metadata preservation
                ).match("low_coverage_stats") }
            )
        }
    }

    test("Should work correctly in stub mode for ABO pipeline testing") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'STUB_barcode99', test_mode:'stub' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_ref' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.tsv.get(0).get(0).id == 'STUB_barcode99' },
                { assert path(process.out.tsv.get(0).get(1)).exists() },
                { assert path(process.out.tsv.get(0).get(1)).name == 'STUB_barcode99.AlignmentStatistics.tsv' },
                // In stub mode, versions should still be captured
                { assert process.out.versions },
                { assert path(process.out.versions.get(0)).text.contains("python:") },
                // Snapshot stub mode behavior
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).size(), // file size should be minimal in stub
                    path(process.out.versions.get(0)).text
                ).match("stub_mode_behavior") }
            )
        }
    }

    test("Should preserve metadata through ABO workflow") {

        when {
            process {
                """
                input[0] = [
                    [
                        id:'Sample1-2024-12345_barcode22',
                        exon:'exon6',
                        sample_type:'patient',
                        expected_phenotype:'A',
                        sequencing_platform:'nanopore'
                    ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_exon6_ref' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Verify all metadata is preserved through snapshots
                { assert snapshot(
                    process.out.tsv.get(0).get(0), // complete metadata map
                    path(process.out.tsv.get(0).get(1)).name // output filename
                ).match("metadata_preservation") },
                // Verify all metadata is preserved
                { assert process.out.tsv.get(0).get(0).id == 'Sample1-2024-12345_barcode22' },
                { assert process.out.tsv.get(0).get(0).exon == 'exon6' },
                { assert process.out.tsv.get(0).get(0).sample_type == 'patient' },
                { assert process.out.tsv.get(0).get(0).expected_phenotype == 'A' },
                { assert process.out.tsv.get(0).get(0).sequencing_platform == 'nanopore' },
                // Verify output file naming follows ABO conventions
                { assert path(process.out.tsv.get(0).get(1)).name.contains('Sample1-2024-12345_barcode22') }
            )
        }
    }

    test("Comprehensive snapshot validation for ABO analysis outputs") {

        when {
            process {
                """
                input[0] = [
                    [ 
                        id:'ABO_VALIDATION_001', 
                        exon:'exon6',
                        phenotype:'A1',
                        sequencing_run:'2024_run_001'
                    ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/mpileup/test.mpileup.gz")
                ]
                input[1] = [
                    [ id:'abo_reference_genome' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/genome/genome.fasta")
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Primary snapshot of all outputs
                { assert snapshot(process.out).match("complete_outputs") },
                
                // Detailed content snapshots
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).text,
                    path(process.out.txt.get(0)).text,
                    path(process.out.versions.get(0)).text
                ).match("file_contents") },
                
                // File characteristics snapshots
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).readLines().size(),
                    path(process.out.txt.get(0)).readLines().size(),
                    path(process.out.tsv.get(0).get(1)).size(),
                    path(process.out.txt.get(0)).size()
                ).match("file_metrics") },
                
                // Metadata preservation snapshot
                { assert snapshot(
                    process.out.tsv.get(0).get(0)
                ).match("preserved_metadata") },
                
                // Content structure snapshots
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).readLines()[0], // header line
                    path(process.out.txt.get(0)).text.split('\n')[0] // first polymorphism line
                ).match("content_headers") },
                
                // Checksums for deterministic validation
                { assert snapshot(
                    path(process.out.tsv.get(0).get(1)).md5,
                    path(process.out.txt.get(0)).md5,
                    path(process.out.versions.get(0)).md5
                ).match("file_checksums") }
            )
        }
    }
}
