nextflow_process {

    name "Test Process MAKEINDEX"
    script "../main.nf"
    process "MAKEINDEX"

    tag "modules"
    tag "modules_nfcore"
    tag "makeindex"
    tag "abotyper"

    test("abotyper - reference fai to bed conversion") {

        when {
            process {
                """
                input[0] = [
                    [ id:'A1_01_01_1_reference_Exon6.fasta', exon:'exon6' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta.fai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'A1_01_01_1_reference_Exon7.fasta', exon:'exon7' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon7.fasta.fai', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.exon6bed[0][1] ==~ ".*/A1_01_01_1_reference_Exon6_exon6.bed" },
                { assert process.out.exon7bed[0][1] ==~ ".*/A1_01_01_1_reference_Exon7_exon7.bed" },
                { assert path(process.out.exon6bed[0][1]).exists() },
                { assert path(process.out.exon7bed[0][1]).exists() },
                { assert path(process.out.exon6bed[0][1]).text.size() > 0 },
                { assert path(process.out.exon7bed[0][1]).text.size() > 0 },
                { assert path(process.out.exon6bed[0][1]).text.contains("\t") },
                { assert path(process.out.exon7bed[0][1]).text.contains("\t") },
                { assert path(process.out.exon6bed[0][1]).text ==~ /Exon6\t0\t134/ },
                { assert path(process.out.exon7bed[0][1]).text ==~ /Exon7\t0\t\d+/ },
                { assert process.out.exon6bed[0][0].id == 'A1_01_01_1_reference_Exon6.fasta' },
                { assert process.out.exon7bed[0][0].id == 'A1_01_01_1_reference_Exon7.fasta' },
                { assert process.out.exon6bed[0][0].exon == 'exon6' },
                { assert process.out.exon7bed[0][0].exon == 'exon7' },
                { assert snapshot(
                    path(process.out.exon6bed[0][1]).text,
                    path(process.out.exon7bed[0][1]).text,
                    process.out.versions
                ).match() },
                { assert process.out.exon6bed.size() == 1 },
                { assert process.out.exon7bed.size() == 1 },
                { assert process.out.versions.size() == 1 }
            )
        }
    }

    test("abotyper - complex id handling") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test.complex.name.fasta', exon:'exon6' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta.fai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'another.test.fasta', exon:'exon7' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon7.fasta.fai', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.exon6bed[0][1] ==~ ".*/test_exon6.bed" },
                { assert process.out.exon7bed[0][1] ==~ ".*/another_exon7.bed" },
                { assert path(process.out.exon6bed[0][1]).exists() },
                { assert path(process.out.exon7bed[0][1]).exists() },
                { assert path(process.out.exon6bed[0][1]).text.size() > 0 },
                { assert path(process.out.exon7bed[0][1]).text.size() > 0 },
                { assert path(process.out.exon6bed[0][1]).text.contains("\t") },
                { assert path(process.out.exon7bed[0][1]).text.contains("\t") },
                { assert process.out.exon6bed[0][0].id == 'test.complex.name.fasta' },
                { assert process.out.exon7bed[0][0].id == 'another.test.fasta' },
                { assert process.out.exon6bed[0][0].exon == 'exon6' },
                { assert process.out.exon7bed[0][0].exon == 'exon7' },
                { assert snapshot(
                    process.out.exon6bed[0][0],
                    process.out.exon7bed[0][0],
                    path(process.out.exon6bed[0][1]).name,
                    path(process.out.exon7bed[0][1]).name
                ).match() }
            )
        }
    }

    test("abotyper - reference fai to bed conversion - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'A1_01_01_1_reference_Exon6.fasta', exon:'exon6' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta.fai', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'A1_01_01_1_reference_Exon7.fasta', exon:'exon7' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon7.fasta.fai', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert path(process.out.exon6bed[0][1]).exists() },
                { assert path(process.out.exon7bed[0][1]).exists() },
                { assert process.out.versions.size() == 1 }
            )
        }
    }
}
