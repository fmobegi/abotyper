// nf-core modules test makeindex
nextflow_process {

    name "Test Process MAKEINDEX"
    script "../main.nf"
    process "MAKEINDEX"

    tag "modules"
    tag "modules_nfcore"
    tag "makeindex"

    test("abo - fai") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_exon6' ], // meta map for exon6
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                input[1] = [
                    [ id:'test_exon7' ], // meta map for exon7
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Detailed content validation with snapshots
                { assert snapshot(
                    path(process.out.exon6bed.get(0).get(1)).text,
                    path(process.out.exon7bed.get(0).get(1)).text,
                    path(process.out.versions.get(0)).text
                ).match("bed_file_contents") },
                // File structure validation
                { assert process.out.exon6bed.get(0).get(1).exists() },
                { assert process.out.exon7bed.get(0).get(1).exists() },
                { assert process.out.versions },
                // Metadata preservation
                { assert process.out.exon6bed.get(0).get(0).id == 'test_exon6' },
                { assert process.out.exon7bed.get(0).get(0).id == 'test_exon7' },
                // File naming conventions
                { assert path(process.out.exon6bed.get(0).get(1)).name.endsWith('_exon6.bed') },
                { assert path(process.out.exon7bed.get(0).get(1)).name.endsWith('_exon7.bed') },
                // Content checksums for deterministic validation
                { assert path(process.out.exon6bed.get(0).get(1)).md5 == snapshot().match("exon6_bed_checksum") },
                { assert path(process.out.exon7bed.get(0).get(1)).md5 == snapshot().match("exon7_bed_checksum") }
            )
        }

    }

    test("abo - fai - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_exon6' ], // meta map for exon6
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                input[1] = [
                    [ id:'test_exon7' ], // meta map for exon7
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // File existence validation for stub mode
                { assert process.out.exon6bed.get(0).get(1).exists() },
                { assert process.out.exon7bed.get(0).get(1).exists() },
                { assert process.out.versions },
                // Metadata preservation in stub mode
                { assert process.out.exon6bed.get(0).get(0).id == 'test_exon6' },
                { assert process.out.exon7bed.get(0).get(0).id == 'test_exon7' },
                // Stub mode behavior snapshots
                { assert snapshot(
                    path(process.out.exon6bed.get(0).get(1)).size(), // should be empty in stub
                    path(process.out.exon7bed.get(0).get(1)).size(), // should be empty in stub
                    path(process.out.versions.get(0)).text
                ).match("stub_mode_behavior") }
            )
        }

    }

    test("BED file format validation with ABO-specific metadata") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_sample_001', exon:'exon6', phenotype:'A1' ], // Extended meta with ABO info
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                input[1] = [
                    [ id:'ABO_sample_002', exon:'exon7', phenotype:'B' ], // Extended meta with ABO info
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Validate BED format structure (tab-separated, 3 columns minimum)
                {
                    def exon6Content = path(process.out.exon6bed.get(0).get(1)).text
                    def lines = exon6Content.split('\n').findAll { !it.isEmpty() }
                    assert lines.size() > 0
                    lines.each { line ->
                        def cols = line.split('\t')
                        assert cols.size() >= 3 // BED format requires at least 3 columns
                        assert cols[1].isNumber() && Integer.parseInt(cols[1]) >= 0 // start position
                        assert cols[2].isNumber() && Integer.parseInt(cols[2]) > Integer.parseInt(cols[1]) // end > start
                    }
                },
                // Snapshot BED content structure
                { assert snapshot(
                    path(process.out.exon6bed.get(0).get(1)).readLines()[0], // first BED line
                    path(process.out.exon7bed.get(0).get(1)).readLines()[0], // first BED line
                    path(process.out.exon6bed.get(0).get(1)).readLines().size(), // line count
                    path(process.out.exon7bed.get(0).get(1)).readLines().size()  // line count
                ).match("bed_structure") },
                // Metadata preservation with ABO-specific fields
                { assert snapshot(
                    process.out.exon6bed.get(0).get(0), // complete metadata
                    process.out.exon7bed.get(0).get(0)  // complete metadata
                ).match("abo_metadata_preservation") }
            )
        }
    }

    test("File naming and output consistency") {

        when {
            process {
                """
                input[0] = [
                    [ id:'Complex_ID.with.dots_123', batch:'batch_001' ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                input[1] = [
                    [ id:'Another-Complex_ID.456', batch:'batch_002' ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Test prefix handling with complex IDs
                {
                    def exon6Name = path(process.out.exon6bed.get(0).get(1)).name
                    def exon7Name = path(process.out.exon7bed.get(0).get(1)).name
                    assert exon6Name.startsWith('Complex_ID') // Should use first part before dot
                    assert exon7Name.startsWith('Another-Complex_ID')
                    assert exon6Name.endsWith('_exon6.bed')
                    assert exon7Name.endsWith('_exon7.bed')
                },
                // Snapshot filename patterns
                { assert snapshot(
                    path(process.out.exon6bed.get(0).get(1)).name,
                    path(process.out.exon7bed.get(0).get(1)).name
                ).match("complex_naming_patterns") }
            )
        }
    }

    test("Comprehensive output validation with all assertions") {

        when {
            process {
                """
                input[0] = [
                    [ 
                        id:'VALIDATION_TEST_001',
                        exon:'exon6',
                        reference:'ABO_reference_v1',
                        analysis_type:'full_typing'
                    ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                input[1] = [
                    [ 
                        id:'VALIDATION_TEST_002',
                        exon:'exon7',
                        reference:'ABO_reference_v1',
                        analysis_type:'full_typing'
                    ],
                    file('https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/genomics/homo_sapiens/genome/genome.fasta.fai', checkIfExists: true),
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Primary output snapshot
                { assert snapshot(process.out).match("complete_outputs") },
                
                // Detailed file content snapshots
                { assert snapshot(
                    path(process.out.exon6bed.get(0).get(1)).text,
                    path(process.out.exon7bed.get(0).get(1)).text,
                    path(process.out.versions.get(0)).text
                ).match("comprehensive_file_contents") },
                
                // File metrics snapshots
                { assert snapshot(
                    path(process.out.exon6bed.get(0).get(1)).readLines().size(),
                    path(process.out.exon7bed.get(0).get(1)).readLines().size(),
                    path(process.out.exon6bed.get(0).get(1)).size(),
                    path(process.out.exon7bed.get(0).get(1)).size()
                ).match("file_metrics") },
                
                // Complete metadata preservation
                { assert snapshot(
                    process.out.exon6bed.get(0).get(0),
                    process.out.exon7bed.get(0).get(0)
                ).match("complete_metadata") },
                
                // Version information validation
                {
                    def versionsText = path(process.out.versions.get(0)).text
                    assert versionsText.contains("MAKEINDEX")
                    assert versionsText.contains("awk:")
                },
                
                // Deterministic checksums
                { assert snapshot(
                    path(process.out.exon6bed.get(0).get(1)).md5,
                    path(process.out.exon7bed.get(0).get(1)).md5,
                    path(process.out.versions.get(0)).md5
                ).match("comprehensive_checksums") }
            )
        }
    }
}
