nextflow_process {

    name "Test Process GETABOSNPS"
    script "../main.nf"
    process "GETABOSNPS"

    tag "getabosnps"
    tag "abotyper"
    tag "abo_blood_typing"
    tag "phenotype_prediction"

    test("Should predict ABO phenotype from exon6 variant data") {

        when {
            process {
                """
                input[0] = [
                    [ id:'NGSPOS_barcode01', exon:'exon6', sample_type:'patient' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon6'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Detailed content validation with snapshots
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).text,
                    path(process.out.log.get(0).get(1)).text,
                    path(process.out.versions.get(0)).text
                ).match("exon6_phenotype_prediction") },
                // File structure validation
                { assert process.out.phenotype.size() == 1 },
                { assert process.out.log.size() == 1 },
                { assert process.out.versions.size() == 1 },
                // Metadata preservation
                { assert process.out.phenotype.get(0).get(0).id == 'NGSPOS_barcode01' },
                { assert process.out.phenotype.get(0).get(0).exon == 'exon6' },
                { assert process.out.log.get(0).get(0).id == 'NGSPOS_barcode01' },
                // File naming conventions
                { assert path(process.out.phenotype.get(0).get(1)).name == 'NGSPOS_barcode01.ABOPhenotype.txt' },
                { assert path(process.out.log.get(0).get(1)).name == 'NGSPOS_barcode01.log.txt' },
                // Content checksums for deterministic validation
                { assert path(process.out.phenotype.get(0).get(1)).md5 == snapshot().match("phenotype_checksum") },
                { assert path(process.out.log.get(0).get(1)).md5 == snapshot().match("log_checksum") }
            )
        }
    }

    test("Should predict ABO phenotype from exon7 variant data") {

        when {
            process {
                """
                input[0] = [
                    [ id:'NGSNEG_barcode12', exon:'exon7', sample_type:'control' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon7'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Content validation with snapshots
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).text,
                    path(process.out.log.get(0).get(1)).text
                ).match("exon7_phenotype_content") },
                { assert process.out.phenotype.get(0).get(0).exon == 'exon7' },
                { assert path(process.out.phenotype.get(0).get(1)).name == 'NGSNEG_barcode12.ABOPhenotype.txt' },
                { assert path(process.out.log.get(0).get(1)).name == 'NGSNEG_barcode12.log.txt' },
                { assert path(process.out.phenotype.get(0).get(1)).exists() },
                { assert path(process.out.log.get(0).get(1)).text.length() > 0 }, // Should contain processing info
                // Checksum validation for reproducibility
                { assert path(process.out.phenotype.get(0).get(1)).md5 == snapshot().match("exon7_phenotype_md5") }
            )
        }
    }

    test("Should handle complex ABO sample naming patterns") {

        when {
            process {
                """
                input[0] = [
                    [
                        id:'IMM-45-44874_barcode25',
                        exon:'exon6',
                        sample_type:'patient',
                        expected_phenotype:'AB'
                    ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon6'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.phenotype.get(0).get(0).id == 'IMM-45-44874_barcode25' },
                { assert process.out.phenotype.get(0).get(0).expected_phenotype == 'AB' },
                { assert path(process.out.phenotype.get(0).get(1)).name.startsWith('IMM-45-44874_barcode25') },
                { assert path(process.out.phenotype.get(0).get(1)).name.endsWith('.ABOPhenotype.txt') },
                { assert path(process.out.log.get(0).get(1)).name.startsWith('IMM-45-44874_barcode25') },
                { assert path(process.out.log.get(0).get(1)).name.endsWith('.log.txt') },
                // Snapshot metadata and filename patterns for complex naming
                { assert snapshot(
                    process.out.phenotype.get(0).get(0), // complete metadata
                    path(process.out.phenotype.get(0).get(1)).name,
                    path(process.out.log.get(0).get(1)).name
                ).match("complex_naming_pattern") }
            )
        }
    }

    test("Should validate ABO phenotype prediction output content") {

        when {
            process {
                """
                input[0] = [
                    [ id:'BTGSPOS_barcode19', exon:'exon6', coverage:'high' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon6'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Validate phenotype file structure for ABO analysis
                {
                    def phenotypeContent = path(process.out.phenotype.get(0).get(1)).text
                    assert phenotypeContent.length() > 0
                },
                // Validate log file contains processing information
                {
                    def logContent = path(process.out.log.get(0).get(1)).text
                    assert logContent.length() > 0
                },
                // Ensure versions capture all required tools for ABO pipeline
                {
                    def versionsContent = path(process.out.versions.get(0)).text
                    assert versionsContent.contains("python:")
                    assert versionsContent.contains("pandas:")
                    assert versionsContent.contains("json5:")
                },
                // Content checksums for deterministic validation
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).text,
                    path(process.out.log.get(0).get(1)).text,
                    path(process.out.versions.get(0)).text
                ).match("abo_content_structure") },
                { assert path(process.out.phenotype.get(0).get(1)).md5 == snapshot().match("abo_phenotype_checksum") }
            )
        }
    }

    test("Should handle low coverage samples gracefully") {

        when {
            process {
                """
                input[0] = [
                    [ id:'INGSPOS_barcode01', exon:'exon7', coverage:'low', quality:'poor' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon7'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.phenotype.size() == 1 },
                { assert process.out.log.size() == 1 },
                { assert process.out.versions.size() == 1 },
                // Even with low coverage, files should be created
                { assert path(process.out.phenotype.get(0).get(1)).exists() },
                { assert path(process.out.log.get(0).get(1)).exists() },
                // Metadata should be preserved
                { assert process.out.phenotype.get(0).get(0).coverage == 'low' },
                { assert process.out.phenotype.get(0).get(0).quality == 'poor' },
                // Snapshot for edge case handling
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).readLines().size(),
                    path(process.out.log.get(0).get(1)).readLines().size(),
                    process.out.phenotype.get(0).get(0) // metadata preservation
                ).match("low_coverage_handling") }
            )
        }
    }

    test("Should work correctly in stub mode") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'STUB_barcode99', exon:'exon6', test_mode:'stub' ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon6'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                { assert process.out.phenotype.get(0).get(0).id == 'STUB_barcode99' },
                { assert path(process.out.phenotype.get(0).get(1)).exists() },
                { assert path(process.out.log.get(0).get(1)).exists() },
                { assert path(process.out.phenotype.get(0).get(1)).name == 'STUB_barcode99.ABOPhenotype.txt' },
                { assert path(process.out.log.get(0).get(1)).name == 'STUB_barcode99.log.txt' },
                { assert process.out.versions },
                { assert path(process.out.versions.get(0)).text.contains("python:") },
                // Snapshot stub mode behavior
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).size(), // should be empty in stub
                    path(process.out.log.get(0).get(1)).size(), // should be empty in stub
                    path(process.out.versions.get(0)).text
                ).match("stub_mode_behavior") }
            )
        }
    }

    test("Should preserve comprehensive metadata through ABO workflow") {

        when {
            process {
                """
                input[0] = [
                    [
                        id:'Sample1-2024-12345_barcode22',
                        exon:'exon6',
                        sample_type:'patient',
                        expected_phenotype:'A',
                        sequencing_platform:'nanopore',
                        coverage_depth:150,
                        quality_score:35
                    ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon6'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() },
                // Verify all metadata is preserved through snapshots
                { assert snapshot(
                    process.out.phenotype.get(0).get(0), // complete metadata map
                    process.out.log.get(0).get(0), // complete metadata map
                    path(process.out.phenotype.get(0).get(1)).name, // output filename
                    path(process.out.log.get(0).get(1)).name // log filename
                ).match("metadata_preservation") },
                // Verify all metadata is preserved
                { assert process.out.phenotype.get(0).get(0).id == 'Sample1-2024-12345_barcode22' },
                { assert process.out.phenotype.get(0).get(0).exon == 'exon6' },
                { assert process.out.phenotype.get(0).get(0).sample_type == 'patient' },
                { assert process.out.phenotype.get(0).get(0).expected_phenotype == 'A' },
                { assert process.out.phenotype.get(0).get(0).sequencing_platform == 'nanopore' },
                { assert process.out.phenotype.get(0).get(0).coverage_depth == 150 },
                { assert process.out.phenotype.get(0).get(0).quality_score == 35 }
            )
        }
    }

    test("Comprehensive ABO phenotype prediction validation") {

        when {
            process {
                """
                input[0] = [
                    [ 
                        id:'ABO_VALIDATION_001', 
                        exon:'exon6',
                        phenotype:'A1',
                        sequencing_run:'2024_run_001'
                    ],
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_variants_freq.tsv"),
                    file("${params.modules_testdata_base_path}/genomics/homo_sapiens/illumina/tsv/test_coverage.txt"),
                    'exon6'
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // Primary snapshot of all outputs
                { assert snapshot(process.out).match("complete_outputs") },
                
                // Detailed content snapshots
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).text,
                    path(process.out.log.get(0).get(1)).text,
                    path(process.out.versions.get(0)).text
                ).match("comprehensive_file_contents") },
                
                // File characteristics snapshots
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).readLines().size(),
                    path(process.out.log.get(0).get(1)).readLines().size(),
                    path(process.out.phenotype.get(0).get(1)).size(),
                    path(process.out.log.get(0).get(1)).size()
                ).match("file_metrics") },
                
                // Metadata preservation snapshot
                { assert snapshot(
                    process.out.phenotype.get(0).get(0),
                    process.out.log.get(0).get(0)
                ).match("preserved_metadata") },
                
                // Version validation
                {
                    def versionsContent = path(process.out.versions.get(0)).text
                    assert versionsContent.contains("GETABOSNPS")
                    assert versionsContent.contains("python:")
                    assert versionsContent.contains("pandas:")
                    assert versionsContent.contains("json5:")
                },
                
                // Checksums for deterministic validation
                { assert snapshot(
                    path(process.out.phenotype.get(0).get(1)).md5,
                    path(process.out.log.get(0).get(1)).md5,
                    path(process.out.versions.get(0)).md5
                ).match("comprehensive_checksums") }
            )
        }
    }
}
