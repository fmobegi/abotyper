nextflow_process {

    name "Test Process GETABOSNPS"
    script "../main.nf"
    process "GETABOSNPS"

    tag "getabosnps"
    tag "abotyper"
    tag "abo_blood_typing"
    tag "snp_extraction"

    test("ABO_AA_barcode01 - exon6") {

        when {
            process {
                """
                input[0] = [
                    [ id:'ABO_AA_barcode01', exon:'exon6', sample_type:'patient' ],
                    file(params.pipelines_testdata_base_path + "/per_sample_processing/ABO_AA_barcode01/exon6/ABO_AA_barcode01.AlignmentStatistics.tsv", checkIfExists: true),
                    file(params.pipelines_testdata_base_path + "/per_sample_processing/ABO_AA_barcode01/exon6/alignment/ABO_AA_barcode01.coverage.txt", checkIfExists: true),
                    'exon6'
                ]
                """
            }
        }

        then {
            assert process.success
            assertAll(
                { assert snapshot(
                    process.out.phenotype,
                    process.out.log,
                    path(process.out.versions[0]).yaml
                ).match() }
            )
        }
    }
}
