nextflow_process {

    name "Test Process ABOSNPS2PHENO"
    script "../main.nf"
    process "ABOSNPS2PHENO"

    tag "modules"
    tag "modules_nfcore"
    tag "abosnps2pheno"
    tag "abotyper"

    test("abotyper - samples compilation") {

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/abotyper/abotyper/', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.txt[0] ==~ ".*/ABO_result.txt" },
                { assert process.out.xls[0] ==~ ".*/ABO_result.xlsx" },
                { assert process.out.log[0] ==~ ".*/ABO_results.log" },
                { assert process.out.csv[0] ==~ ".*/final_export.csv" },
                { assert path(process.out.txt[0]).exists() },
                { assert path(process.out.xls[0]).exists() },
                { assert path(process.out.log[0]).exists() },
                { assert path(process.out.csv[0]).exists() },
                { assert path(process.out.txt[0]).text.contains("ABO") || path(process.out.txt[0]).text.size() > 0 },
                { assert path(process.out.csv[0]).text.contains(",") || path(process.out.csv[0]).text.size() > 0 },
                { assert snapshot(process.out.versions).match() }
            )
        }
    }

    test("abotyper - samples compilation - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = file(params.pipelines_testdata_base_path + '/abotyper/abotyper/', checkIfExists: true)
                input[1] = file(params.pipelines_testdata_base_path + '/abotyper/abotyper/per_sample_processing', checkIfExists: true)
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
