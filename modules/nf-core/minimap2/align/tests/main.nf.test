        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample', exon:'exon6' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/mpileup/test_exon6.mpileup.gz', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'exon6_ref' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

