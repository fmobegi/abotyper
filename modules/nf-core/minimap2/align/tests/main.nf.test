nextflow_process {

    name "Test Process MPILEUP_NUCL_FREQ"
    script "../main.nf"
    process "MPILEUP_NUCL_FREQ"

    tag "modules"
    tag "modules_nfcore"
    tag "mpileup_nucl_freq"
    tag "abotyper"

    test("abotyper - exon6 - test data") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample', exon:'exon6' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/mpileup/test_exon6.mpileup.gz', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'exon6_ref' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon6.fasta', checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    path(process.out.tsv[0][1]).readLines()[0..2],
                    path(process.out.txt[0]).name,
                    process.out.versions
                ).match() }
            )
        }
    }

    test("abotyper - exon7 - test data") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample', exon:'exon7' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/mpileup/test_exon7.mpileup.gz', checkIfExists: true)
