        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test_sample', exon:'exon7' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/mpileup/test_exon7.mpileup.gz', checkIfExists: true)
                ]
                input[1] = [
                    [ id:'exon7_ref' ],
                    file(params.pipelines_testdata_base_path + '/abotyper/abotyper/refs/A1_01_01_1_reference_Exon7.fasta', checkIfExists: true)
                ]
